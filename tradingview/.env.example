# ──────────────────────────────────────────────────────────────────────────────
# EXCHANGE — set to "zerodha" for NSE, or "bitget" for crypto (default)
# ──────────────────────────────────────────────────────────────────────────────
EXCHANGE=zerodha

# ──────────────────────────────────────────────────────────────────────────────
# ZERODHA / KITE CONNECT  (NSE — stocks & F&O)
# Get your API key from: https://developers.kite.trade/apps
# See docs/exchanges/zerodha-kite.md for the full setup guide
# ──────────────────────────────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=                    # Updated daily by: node kite-auth.js

# The instrument token for the stock you want to trade.
# Look it up at: https://api.kite.trade/instruments/NSE
# Examples: RELIANCE=738561, TCS=2953217, INFY=408065, NIFTY50 (index)=256265
KITE_INSTRUMENT_TOKEN=738561

NSE_EXCHANGE=NSE                      # NSE or BSE
TRADE_PRODUCT=MIS                     # MIS = intraday | CNC = delivery

# Portfolio in INR
PORTFOLIO_VALUE_INR=100000
MAX_TRADE_SIZE_INR=10000
MAX_TRADES_PER_DAY=3

# ──────────────────────────────────────────────────────────────────────────────
# BITGET  (Crypto — leave blank if using Zerodha)
# Get credentials from: BitGet → API Management
# See docs/exchanges/bitget.md for setup guide
# ──────────────────────────────────────────────────────────────────────────────
# BITGET_API_KEY=your_api_key_here
# BITGET_SECRET_KEY=your_secret_key_here
# BITGET_PASSPHRASE=your_passphrase_here
# TRADE_MODE=spot
# PORTFOLIO_VALUE_USD=1000
# MAX_TRADE_SIZE_USD=100

# ──────────────────────────────────────────────────────────────────────────────
# SHARED SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
SYMBOL=RELIANCE                       # Stock symbol (e.g. RELIANCE, TCS, INFY)
TIMEFRAME=1H                          # 1m 5m 15m 30m 1H 1D  (Kite max intraday: 1H)

# Set to "false" to go live — paper mode logs decisions but places no real orders
PAPER_TRADING=true

# Optional: Apify key for YouTube strategy extraction
# APIFY_API_KEY=your_apify_token_here
