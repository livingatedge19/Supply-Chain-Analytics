# BitGet API credentials
# Get these from: BitGet account → API Management
# Withdrawals: OFF.  IP whitelist: ON (recommended).
BITGET_API_KEY=your_api_key_here
BITGET_SECRET_KEY=your_secret_key_here
BITGET_PASSPHRASE=your_passphrase_here

# Trading mode: "spot" or "futures"
TRADE_MODE=spot

# Symbol and timeframe
SYMBOL=BTCUSDT
TIMEFRAME=4H

# Portfolio value — used to calculate position size
PORTFOLIO_VALUE_USD=1000

# Trade guardrails
MAX_TRADE_SIZE_USD=100
MAX_TRADES_PER_DAY=3

# Set to "false" to go live (paper trades by default — safe for testing)
PAPER_TRADING=true

# Optional: Apify key for YouTube strategy extraction (Step 4, option 3)
# APIFY_API_KEY=your_apify_token_here
